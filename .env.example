# ==============================================================================
# Open Ethiopia Map & Routing Platform - Environment Configuration
# ==============================================================================

NODE_ENV=production
PORT=7860

# Internal OSRM connection (handled automatically inside Docker container)
OSRM_INTERNAL_PORT=5000
OSRM_BASE_URL=http://127.0.0.1:5000

# PostgreSQL Database URL
# For local Docker: postgresql://postgres:postgres@localhost:5432/packman_maps?schema=public
# For Free Cloud: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
MAP_DATABASE_URL=postgresql://postgres:postgres@map-postgres:5432/packman_maps?schema=public

# Redis Cache URL
# For local Docker: redis://map-redis:6379/0
# For Free Cloud: rediss://default:[PASSWORD]@[HOST].upstash.io:6379
MAP_REDIS_URL=redis://map-redis:6379/0

# Cache TTL Configurations (Seconds)
MAP_CACHE_TTL_ROUTE=3600
MAP_CACHE_TTL_AUTOCOMPLETE=1800
MAP_CACHE_TTL_REVERSE=86400
MAP_CACHE_TTL_NEARBY=900

# Optional External Geocoding Fallbacks
PHOTON_BASE_URL=https://photon.komoot.io
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
